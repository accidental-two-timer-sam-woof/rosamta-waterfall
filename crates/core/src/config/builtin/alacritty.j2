{#- rosamta
program = "alacritty"
format_version = "0.15"
[requires]
theme = 1
font = 1
terminal = 1
-#}
[colors.primary]
foreground = "{{ theme.foreground }}"
background = "{{ theme.background }}"
{% if theme.cursor is not none %}
[colors.cursor]
cursor = "{{ theme.cursor }}"
{% endif %}{% set colors = ["black","red","green","yellow","blue","magenta","cyan","white"] %}
[colors.normal]
{% for name in colors %}{{ name }} = "{{ theme.ansi[loop.index0] }}"
{% endfor %}
[colors.bright]
{% for name in colors %}{{ name }} = "{{ theme.ansi[loop.index0 + 8] }}"
{% endfor %}{% if theme.opacity is not none %}
[window]
opacity = {{ theme.opacity }}
{% endif %}{% if font.size is not none %}
[font]
size = {{ font.size }}
{% endif %}{% if font.family is not none %}
[font.normal]
family = {{ font.family | tojson }}
{% endif %}{% if terminal.cursor_shape is not none %}
[cursor.style]
shape = "{{ {"block":"Block","beam":"Beam","underline":"Underline"}[terminal.cursor_shape] }}"
{% endif %}{% if terminal.scrollback is not none %}
[scrolling]
history = {{ terminal.scrollback }}
{% endif %}{% if terminal.keybindings is not none %}{% set actions = {"copy":"Copy","paste":"Paste","new_tab":"CreateNewTab","next_tab":"SelectNextTab","previous_tab":"SelectPreviousTab","increase_font_size":"IncreaseFontSize","decrease_font_size":"DecreaseFontSize","reset_font_size":"ResetFontSize"} %}
{% set aliases = {"ctrl":"Control","control":"Control","shift":"Shift","alt":"Alt","option":"Option","super":"Super","cmd":"Command","command":"Command"} %}
{% macro modifiers(parts) -%}
{%- for mod in parts -%}{% if (mod | lower) in aliases %}{{ aliases[mod | lower] }}{% else %}{{ mod }}{% endif %}{% if not loop.last %}|{% endif %}{%- endfor -%}
{%- endmacro %}
{% set named_keys = {"tab":"Tab","enter":"Enter","escape":"Escape","space":"Space","backspace":"Backspace","left":"ArrowLeft","right":"ArrowRight","up":"ArrowUp","down":"ArrowDown"} %}
{% for key, action in terminal.keybindings | items %}{% if action != "close_tab" and (host.os == "macos" or action not in ["new_tab", "next_tab", "previous_tab"]) %}{% set parts = key | split("+") %}
{% set last = parts[-1] %}
[[keyboard.bindings]]
key = {% if (last | lower) in named_keys %}{{ named_keys[last | lower] | tojson }}{% elif last | length == 1 %}{{ last | upper | tojson }}{% else %}{{ last | tojson }}{% endif %}
{% if parts | length > 1 %}mods = {{ modifiers(parts[:-1]) | tojson }}
{% endif %}action = {{ actions[action] | tojson }}
{% endif %}{% endfor %}{% endif %}
